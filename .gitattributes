# Força LF nos scripts shell e configs — necessário para execução no Linux
*.sh        text eol=lf
*.conf      text eol=lf
*.php       text eol=lf
*.sql       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.env       text eol=lf

# Configurações de serviço dos módulos (extensões que não casam com as regras
# acima). Sem isto o checkout no Windows pode gravar CRLF e o BIND9/dnsmasq
# recusam o arquivo no Linux.
named.conf.*        text eol=lf
db.rpz.*            text eol=lf
*.modelo            text eol=lf
